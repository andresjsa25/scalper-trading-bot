# Copiar este archivo a ".env" y completar con las claves reales.
# ".env" NUNCA se sube al repo (ya está en .gitignore) — este ".env.example"
# sí se sube, pero solo como plantilla, sin ningún valor real.

# --- BingX (API key con permisos de trading de futuros/swap) ---
# Se consiguen en https://bingx.com -> API Management. Nunca actives el
# permiso de "retiro" (withdraw) en esta key: el bot solo necesita leer
# mercado y operar (crear/cerrar posiciones), retirar fondos no.
BINGX_API_KEY=tu_api_key_aqui
BINGX_API_SECRET=tu_api_secret_aqui

# --- Modo simulación (opcional) ---
# "true" corre el loop de trading en vivo con datos reales pero sin mandar
# ninguna orden real al exchange (dry run) — útil para probar cambios de
# config antes de arriesgar capital real. Default: false (opera en serio).
LIVE_TRADING_DRY_RUN=false
